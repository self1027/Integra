<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Frases da Aula</title>

    <link rel="icon" type="image/png" sizes="96x96" href="/img/integra/favicon/favicon-96x96.png" />
    <link rel="icon" type="image/svg+xml" href="/img/integra/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/img/integra/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/img/integra/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/img/integra/favicon/site.webmanifest" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #3498db;
            --primary-dark: #2980b9;
            --bg: #f0f4f8;
            --text: #2c3e50;
            --muted: #7f8c8d;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #f0f4f8 0%, #e6ecf1 100%);
            color: var(--text);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .container {
            background: white;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            padding: 3rem 2rem;
            max-width: 900px;
            width: 100%;
            text-align: center;
        }

        h1 {
            font-size: 2.2rem;
            margin-bottom: 1rem;
        }

        p.subtitle {
            font-size: 1.1rem;
            color: var(--muted);
            margin-bottom: 2rem;
        }

        .btn-group {
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
            margin: 2rem 0;
        }

        .btn {
            flex: 1;
            min-width: 200px;
            max-width: 300px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.2rem 2rem;
            border-radius: 10px;
            background-color: var(--primary);
            color: #fff;
            font-weight: 600;
            text-decoration: none;
            transition: 0.3s ease;
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
        }

        .btn i {
            font-size: 1.5rem;
            margin-right: 0.7rem;
        }

        .btn:hover {
            background-color: var(--primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
        }

        .btn.back {
            background-color: #6c757d;
        }

        .btn.back:hover {
            background-color: #5a6268;
        }

        .btn.new {
            background-color: #28a745;
        }

        .btn.new:hover {
            background-color: #218838;
        }

        .footer {
            margin-top: 2.5rem;
            font-size: 0.85rem;
            color: var(--muted);
        }

        /* Estilos específicos para frases */
        .meta {
            background: rgba(52, 152, 219, 0.1);
            padding: 1rem;
            border-radius: 10px;
            margin: 1.5rem 0;
            display: flex;
            justify-content: center;
            gap: 1.5rem;
            flex-wrap: wrap;
        }

        .meta span {
            font-size: 0.9rem;
            color: var(--muted);
        }

        .phrase {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 1.5rem;
            margin: 1rem 0;
            text-align: left;
            border-left: 4px solid var(--primary);
        }

        .phrase .raw {
            font-size: 1.1rem;
            margin-bottom: 0.5rem;
            color: var(--text);
        }

        .phrase .translated {
            font-style: italic;
            color: var(--muted);
            padding: 0.5rem 0;
            border-top: 1px solid #e9ecef;
        }

        .phrase-meta {
            display: flex;
            gap: 1rem;
            margin-top: 0.5rem;
            font-size: 0.85rem;
            color: var(--muted);
            flex-wrap: wrap;
        }

        .empty {
            padding: 3rem;
            color: var(--muted);
            font-style: italic;
        }

        @media (max-width: 500px) {
            h1 {
                font-size: 1.6rem;
            }

            .container {
                padding: 2rem 1.5rem;
            }

            .btn-group {
                flex-direction: column;
            }

            .meta {
                flex-direction: column;
                gap: 0.5rem;
                text-align: center;
            }

            .phrase-meta {
                flex-direction: column;
                gap: 0.3rem;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>
        <%= lesson.title || 'Frases da Aula' %>
        <button id="renameBtn" title="Renomear aula" style="border:none;background:none;color:#7f8c8d;cursor:pointer;font-size:1rem;margin-left:8px;">
            <i class="fas fa-pen"></i>
        </button>
        <button id="deleteBtn" title="Excluir aula" style="border:none;background:none;color:#e74c3c;cursor:pointer;font-size:1rem;margin-left:4px;">
            <i class="fas fa-trash"></i>
        </button>
        </h1>
        <p class="subtitle">Visualize e revise as frases traduzidas desta aula</p>

        <div class="btn-group">
            <a href="/lesson" class="btn back">
                <i class="fas fa-arrow-left"></i>
                Voltar para Lista
            </a>
            <a href="/" class="btn new">
                <i class="fas fa-microphone"></i>
                Nova Aula
            </a>
        </div>

        <% if (!lesson) { %>
            <div class="empty">
                Aula não encontrada.
            </div>
        <% } else if (lesson.phrases.length === 0) { %>
            <div class="empty">
                Esta aula não possui frases.
            </div>
        <% } else { %>
            <div class="meta">
                <span><strong>Data:</strong> <%= new Date(lesson.startedAt).toLocaleString('pt-BR') %></span>
                <span><strong>Total de frases:</strong> <%= lesson.phrases.length %></span>
                <span><strong>Duração:</strong> <%= lesson.duration %> segundos</span>
            </div>

            <% lesson.phrases.forEach((phrase, index) => { %>
                <div class="phrase">
                    <div class="raw">
                        <%= phrase.raw %>
                    </div>
                    <% if (phrase.translated) { %>
                        <div class="translated">
                            <strong>Tradução:</strong> <%= phrase.translated %>
                        </div>
                    <% } %>
                </div>
            <% }) %>
        <% } %>
        
        <p class="footer">Integra - Facilitando a comunicação e inclusão</p>
    </div>
      <div vw class="enabled">
    <div vw-access-button class="active"></div>
    <div vw-plugin-wrapper>
      <div class="vw-plugin-top-wrapper"></div>
    </div>
  </div>

  <script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
  <script>new window.VLibras.Widget('https://vlibras.gov.br/app');</script>
  <script>
  const lessonId = "<%= lesson._id %>";

  document.getElementById("renameBtn")?.addEventListener("click", async () => {
    const newName = prompt("Novo nome para a aula:");
    if (!newName) return;

    try {
      const res = await fetch(`/lesson/${lessonId}/rename`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ title: newName })
      });

      if (!res.ok) throw new Error("Falha ao renomear aula");

      const data = await res.json();
      alert("Aula renomeada com sucesso!");
      location.reload();
    } catch (err) {
      alert("Erro: " + err.message);
    }
  });

  document.getElementById("deleteBtn")?.addEventListener("click", async () => {
    if (!confirm("Tem certeza que deseja excluir esta aula?")) return;

    try {
      const res = await fetch(`/lesson/${lessonId}`, { method: "DELETE" });
      if (!res.ok) throw new Error("Falha ao excluir aula");
      alert("Aula excluída com sucesso!");
      window.location.href = "/lesson";
    } catch (err) {
      alert("Erro: " + err.message);
    }
  });
</script>

</body>
</html>