<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Aulas de inglês com reconhecimento de voz e tradução">
  <title>Integra - ADM</title>
  
  <link rel="icon" type="image/png" sizes="96x96" href="/img/ADM/favicon/favicon-96x96.png" />
  <link rel="icon" type="image/svg+xml" href="/img/ADM/favicon/favicon.svg" />
  <link rel="shortcut icon" href="/img/ADM/favicon/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/img/ADM/favicon/apple-touch-icon.png" />
  <link rel="manifest" href="/img/ADM/favicon/site.webmanifest" />
  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/VLibras.css">
  <link rel="stylesheet" href="/css/english.css">
</head>
<body>
  <header class="header">
    <div class="controls">
      <button id="startBtn" class="btn btn-primary">
        <i class="fas fa-play"></i>
        Conectar
      </button>
      <button id="stopBtn" class="btn btn-danger" disabled>
        <i class="fas fa-stop"></i>
        Desconectar
      </button>
    </div>
    
    <div id="status" class="status disconnected">
      <i class="fas fa-circle"></i>
      Status: Desconectado
    </div>
  </header>

  <div class="back-link-container">
    <a href="/" class="back-link">
      <i class="fas fa-arrow-left"></i>
      Voltar
    </a>
  </div>

  <main class="content">
    <div id="phrases-container" class="phrases-container"></div>
  </main>

  <div vw class="enabled">
    <div vw-access-button class="active"></div>
    <div vw-plugin-wrapper>
      <div class="vw-plugin-top-wrapper"></div>
    </div>
  </div>

  <script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
  <script>new window.VLibras.Widget('https://vlibras.gov.br/app');</script>
  <script>
    document.querySelectorAll('.btn-translate').forEach(btn => {
      btn.addEventListener('click', () => {
        const translation = btn.parentElement.querySelector('.translation');
        translation.classList.toggle('visible');
      });
    });
  </script>
  <script type="module" src="/js/lesson-memory.js"></script>
  <script src="/js/audio_ws.js"></script>
  <script src="/js/ADM/features.js"></script>
</body>
</html>
