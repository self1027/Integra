<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Solução de acessibilidade com VLibras para transmissão de áudio">
  <title>Integra - MQF</title>
  
  <link rel="apple-touch-icon" sizes="180x180" href="/img/MQF/favicon/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/img/MQF/favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/img/MQF/favicon/favicon-16x16.png">
  <link rel="manifest" href="/img/MQF/favicon/site.webmanifest">
  <link rel="icon" type="image/x-icon" href="/img/MQF/favicon/favicon.ico">
  <link rel="shortcut icon" href="/img/MQF/favicon/favicon.ico">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/VLibras.css">
  <link rel="stylesheet" href="/css/MQF/app.css">
</head>
<body>
  <div vw class="enabled">
    <div vw-access-button class="permanently-hidden"></div>
    <div vw-plugin-wrapper>
      <div class="vw-plugin-top-wrapper"></div>
    </div>
  </div>

  <header class="header">
    <div class="controls">
      <button id="startBtn" class="btn btn-primary">
        <i class="fas fa-play"></i>
        Conectar
      </button>
      <button id="stopBtn" class="btn btn-danger" disabled>
        <i class="fas fa-stop"></i>
        Desconectar
      </button>
    </div>
    
    <div id="status" class="status disconnected">
      <i class="fas fa-circle"></i>
      Status: Desconectado
    </div>
  </header>

  <div class="back-link-container">
    <a href="/MQF" class="back-link">
      <i class="fas fa-arrow-left"></i>
      Voltar
    </a>
  </div>
  <div vw class="enabled">
    <div vw-access-button class="permanently-hidden"></div>
    <div vw-plugin-wrapper>
      <div class="vw-plugin-top-wrapper"></div>
    </div>
  </div>
  <script src="/js/script-vlibras.js"></script>
  <script type="module" src="/js/vlibras-loader.js"></script>
  <script src="/js/audio_ws.js"></script>
</body>
</html>